# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments
.venv/
venv/
.env
.env.*
# Un-ignored by name rather than by a *.example glob, so adding a new example
# file is a deliberate act. .env.production.example was silently swallowed by
# the rule above and shipped a test that read a file CI never had.
!.env.example
!.env.production.example

# Instance data - databases, uploads, generated documents
instance/
*.db
*.sqlite3

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Secrets - belt and braces alongside the secret scanner
*.pem
*.key
secrets/
