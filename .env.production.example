# Production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Nothing here has a working default. Compose refuses to start with any required
# value unset and names the one that is missing; the application refuses too, on
# the list in DEPLOYMENT.md §2. Failing to start is cheaper than failing open.
#
# SPDX-License-Identifier: MIT

# --- Secrets --------------------------------------------------------------

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Back this up somewhere with a different blast radius from the database. If it
# lives in the same secret store and that store is what you lose, the restore
# comes back and every encrypted column is unreadable — which is why
# docs/runbooks/disaster-recovery.md puts key recovery *before* the restore.
FIELD_ENCRYPTION_KEY=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBHOOK_SIGNING_SECRET=

# python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- Object storage -------------------------------------------------------
#
# Production refuses local disk for documents: it is not durable across
# replicas, and a restore that comes back without them has failed quietly.
# The compose file runs MinIO so this works with no cloud account. To use S3,
# R2, or Spaces instead, point STORAGE_ENDPOINT_URL at them, set real
# credentials, and delete the `minio` and `createbucket` services.

# python -c "import secrets; print(secrets.token_urlsafe(16))"
STORAGE_ACCESS_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
STORAGE_SECRET_KEY=
STORAGE_BUCKET=atlas-documents
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_REGION=us-east-1

# --- Mail -----------------------------------------------------------------
#
# Also required: production refuses the console backend. Delinquency notices
# carry statutory response deadlines, and a backend that prints them to a log
# has not sent them.
#
# MAIL_FROM must be a mailbox on a domain you control. Production refuses the
# reserved placeholder domains (example.com, anything under .example/.invalid/
# .test/.localhost) because mail from them cannot pass SPF at the receiving
# end — and that rejection never travels back here, so Atlas would record every
# notice as sent while the recipient's server silently drops it.

MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Worth setting deliberately -------------------------------------------

# Comma-separated origins for the browser surfaces. A wildcard is refused: it
# would hand any origin an authenticated session. A JSON array works too.
CORS_ALLOWED_ORIGINS=https://atlas.example.com

# Pin this. `:0.7.1` rather than `:latest`, so a restart six months from now
# brings back the version you tested rather than whatever was pushed since.
ATLAS_IMAGE=ghcr.io/ibuilder/atlas:0.7.1

# How many reverse proxies sit in front of Atlas, counted from the outside in.
# One TLS terminator is 1. Behind a load balancer *and* a terminator, 2.
#
# Set this. The web port below is bound to loopback precisely so a proxy is in
# front, and while this stays 0 every request appears to come from that proxy
# rather than from a person. The address is written into the screening-consent
# record that FCRA treats as evidence, into every audit event, into login
# history, and into the per-address rate-limit key - which then means one
# shared bucket for the whole internet. An IP-restricted API token would accept
# every caller, because they all look like the proxy.
#
# It defaults to 0 rather than 1 because trusting `X-Forwarded-For` with no
# proxy in front lets any client name its own address, and a consent record
# somebody can forge is worse than one that is obviously wrong.
TRUSTED_PROXY_COUNT=

# The public address of this deployment, with scheme and no trailing path.
# Builds password-reset links and the OpenAPI server URL. Production refuses a
# localhost or plain-HTTP value: a reset link pointing at localhost reaches the
# one person least able to report it, because they are already locked out.
APP_URL=https://atlas.your-company.com

# Published on loopback only; put a TLS-terminating proxy in front of it.
WEB_PORT=8000
WEB_WORKERS=4
