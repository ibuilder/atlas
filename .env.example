# Atlas PMOS configuration.
#
# Copy to .env and fill in. Production refuses to start if SECRET_KEY or
# FIELD_ENCRYPTION_KEY is missing, weak, or a well-known placeholder - that is
# deliberate, and it is not a bug to work around.
#
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --------------------------------------------------------------------- core
ATLAS_ENV=development
APP_NAME=Atlas PMOS
APP_URL=http://localhost:5000

SECRET_KEY=
# Fernet key. Encrypts MFA seeds, tax identifiers, and bank details at rest.
# Comma-separate to rotate: the first key encrypts, all keys decrypt.
FIELD_ENCRYPTION_KEY=

# ----------------------------------------------------------------- database
# Development falls back to a local SQLite file. Staging and production
# require PostgreSQL and refuse to start without it.
DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=30000
DB_ENABLE_RLS=true

# -------------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ----------------------------------------------------------------- security
FORCE_HTTPS=true
SESSION_LIFETIME_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=60
# How long a sensitive action can run on a previous MFA assertion.
SESSION_PRIVILEGED_REAUTH_MINUTES=240
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
MFA_REQUIRED_FOR_PRIVILEGED=true

# Number of proxies in front of the app. 0 means X-Forwarded-* is not trusted -
# raise it only to the real count, or a client can forge its own source IP.
TRUSTED_PROXY_COUNT=0
CORS_ALLOWED_ORIGINS=

# Signs outbound webhooks so receivers can verify origin.
WEBHOOK_SIGNING_SECRET=

# ------------------------------------------------------------------ storage
# Production requires object storage; local disk is not durable across replicas.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=instance/storage
STORAGE_BUCKET=
STORAGE_REGION=
UPLOAD_MAX_BYTES=52428800
MALWARE_SCAN_REQUIRED=true

# ------------------------------------------------------------ observability
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
# When set, /metrics requires this bearer token.
METRICS_TOKEN=
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=300
SENTRY_DSN=

# ------------------------------------------------------------- integrations
MAIL_BACKEND=console
MAIL_FROM=no-reply@atlas.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
PAYMENTS_BACKEND=mock
SCREENING_BACKEND=mock
ESIGN_BACKEND=mock

# ----------------------------------------------------------------- features
FEATURE_AUTOMATION_ENGINE=true
FEATURE_OWNER_PORTAL=true
FEATURE_VENDOR_PORTAL=true
FEATURE_OPENAPI_UI=true
# AI stays off until governance controls are configured. See ADR-0006.
FEATURE_AI_COPILOT=false
